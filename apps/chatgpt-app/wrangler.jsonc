{
  "name": "harness-x-harness-task-runner-control-plane",
  "main": "src/index.ts",
  "build": { "command": "npm run build:ui" },
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],
  "compatibility_date": "2026-07-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Request URLs can contain OAuth codes. Keep invocation logs and tracing off.
  // redact_query_string is also enabled via script-settings API; this Wrangler
  // version does not expose that setting.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": { "enabled": false }
  },
  "routes": [
    {
      "pattern": "runners.trustedtunnel.app",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENT_DELIVERY",
        "class_name": "EventDeliveryContainer"
      },
      {
        "name": "AUTHORIZATION_STATES",
        "class_name": "AuthorizationStateObject"
      },
      {
        "name": "ENVIRONMENTS",
        "class_name": "BoundedEnvironmentObject"
      },
      {
        "name": "ENVIRONMENT_ADMISSION",
        "class_name": "EnvironmentAdmissionObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TaskObject"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "AuthorizationStateObject"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "EnvironmentObject"
      ]
    },
    {
      "tag": "v4",
      "deleted_classes": [
        "TaskObject"
      ]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": [
        "TaskRuntimeObject"
      ]
    },
    {
      "tag": "v6",
      "deleted_classes": [
        "EnvironmentObject"
      ]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["BoundedEnvironmentObject", "EnvironmentAdmissionObject"]
    },
    {
      "tag": "v8",
      "deleted_classes": ["TaskRuntimeObject"]
    },
    {
      "tag": "v9",
      "new_sqlite_classes": ["EventDeliveryContainer"]
    }
  ],
  "containers": [{
    "class_name": "EventDeliveryContainer",
    "image": "../event-delivery/Dockerfile",
    "instance_type": "lite",
    "max_instances": 1
  }],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "64bbcdb21ec14e2ba1c93be3c8f537a4"
    }
  ],
  "vars": {
    "GITHUB_CI_EVENT_REPOSITORIES": "[\"Harness-X-Harness/runner\"]",
    "ENVIRONMENT_STARTUP_MS": 600000,
    "GITHUB_RUNNER_REPOSITORY": "Harness-X-Harness/runner",
    "GITHUB_RUNNER_REF": "main",
    "GITHUB_APP_CLIENT_ID": "Iv23liSTFd2ASGA4MmkF",
    "TASK_CONTROL_PLANE_URL": "https://runners.trustedtunnel.app"
  }
}
